# ═══════════════════════════════════════════════════════════════════════════════
# SEP 生产环境变量
# 复制此文件为 .env 并填写所有值
# ═══════════════════════════════════════════════════════════════════════════════

# ── 从 /opt/longdao/deploy/production/.env 复制以下三项 ──────────────────────
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=
SEP_DB_USER=sep_app
SEP_DB_PASSWORD=
# 当前 longdao-redis 未启用 AUTH，默认使用 DB 1；启用认证时改为完整 redis:// URL
REDIS_URL=redis://longdao-redis:6379/1
# 仅供启用认证的旧配置保留，不会覆盖 REDIS_URL
REDIS_PASSWORD=

# ── SEP 专属配置 ──────────────────────────────────────────────────────────────

# 兼容旧模块的 JWT 密钥（生成命令：openssl rand -hex 32）
JWT_SECRET=
# 认证中心专用密钥：必须分别生成，不能互相复用（均至少 32 字符）
ACCESS_JWT_SECRET=
REFRESH_TOKEN_PEPPER=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=__Host-sep_refresh
CORS_ORIGIN=https://longdaoSEP.cn
NEXT_PUBLIC_WS_URL=wss://longdaoSEP.cn

# 邮件（生产必须启用，用于密码找回、邮箱验证、新设备通知）
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=硅基人才平台

# 国内第三方登录（未完成开放平台备案/回调配置前保持 false）
OAUTH_TRANSACTION_TTL_SECONDS=300
WECHAT_OAUTH_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://longdaoSEP.cn/api/auth/oauth/wechat/callback
QQ_OAUTH_ENABLED=false
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=https://longdaoSEP.cn/api/auth/oauth/qq/callback

# 蓝绿发布后的有界观察（部署脚本读取，可按生产告警窗口调整）
SEP_POST_DEPLOY_CHECKS=6
SEP_POST_DEPLOY_INTERVAL_SECONDS=10

# sub2api API Key
# 在 sub2api 管理后台（https://你的longdao域名）创建一个渠道 key，填入此处
SUB2API_API_KEY=

# sub2api 地址与默认模型
# 容器名默认 longdao-sub2api-blue；中转切换蓝绿或改名后必须在这里覆盖，
# 否则后端连不上中转 —— 症状是「工作安排」报「任务规划模型暂时不可用」。
# 模型必须是中转真实提供的：
#   curl -H "Authorization: Bearer $SUB2API_API_KEY" <base_url>/models
# 实测该中转只提供 gemini-* 系列，填 gpt-* / claude-* 会 404 model_not_found。
SUB2API_BASE_URL=http://longdao-sub2api-blue:8080/v1
SUB2API_DEFAULT_MODEL=gemini-3.5-flash-high

# 知识库 Embedding（独立 Ollama 服务）
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://sep-ollama:11434/v1
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_KEY=ollama-local
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=120000

# ---- SEP 专属数据库角色（必填）---------------------------------------------
# 这台机器的 PostgreSQL 与龙道 AI 中转共用实例。SEP 必须使用自己的低权角色，
# 不要复用中转的超级用户（POSTGRES_USER）。建角色见 docs 或运维脚本：
#   CREATE ROLE sep_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '...';
#   ALTER DATABASE sep_prod OWNER TO sep_app;   -- 连同库内对象属主一起迁移
#   REVOKE CONNECT ON DATABASE sub2api FROM PUBLIC;  -- 禁止 SEP 连中转的库
SEP_DB_USER=sep_app
SEP_DB_PASSWORD=
