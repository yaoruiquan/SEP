# Database
DATABASE_URL="postgresql://sep:sep_dev_password@localhost:5432/sep_platform?schema=public"

# JWT
JWT_SECRET="sep-jwt-secret-change-in-production"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:4173"

# sub2api (Token 中转站, OpenAI 兼容端点 —— 所有模型调用走它)
# 由你部署在服务器上，替换为真实地址和 key
SUB2API_BASE_URL="https://your-sub2api-host/v1"
SUB2API_API_KEY="your-sub2api-key"
# 中转站已接入的模型名（逗号分隔），例如 deepseek-chat,doubao-pro,qwen-max
SUB2API_MODELS="deepseek-chat"

# OpenCode Skills Service (独立 HTTP 服务, 参考 opencode-skiills-service)
# 未部署可留空；留空时相关测试端点返回 not_implemented
OPENCODE_API_BASE_URL=""
OPENCODE_API_TOKEN=""

# Redis (for session/cache)
REDIS_URL="redis://localhost:6379"
