# Database
DATABASE_URL="postgresql://sep:sep_dev_password@localhost:5432/sep_platform?schema=public"

# JWT（JWT_SECRET 仅供开发环境兼容；生产必须使用下方独立密钥）
JWT_SECRET="sep-jwt-secret-change-in-production"

# Server
PORT=3001
NODE_ENV=development

# Public web/CDN origin serving /assets (not the API origin). Required in production.
ASSET_BASE_URL="http://localhost:3000"
DEFAULT_AVATAR_STYLE="silicon-3d"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:4173"

# sub2api (Token 中转站, OpenAI 兼容端点 —— 所有模型调用走它)
SUB2API_BASE_URL="https://longdaoai.cn/v1"
SUB2API_API_KEY="your-sub2api-key-here"
# 模型 ID 必须是 sub2api 上游实际存在的（GET /v1/models 确认）。
# 注意：默认模型必须支持 function calling，否则带工具的会话会被上游拒绝
# （deepseek-v4-flash 不支持 tools，请求含 tools 时返回 400 Invalid request）。
SUB2API_DEFAULT_MODEL="gemini-3.5-flash"

# 计费汇率：模型单价以 USD 计，入账以 CNY 计。
# 优先级：SystemSetting 表（管理端可改）> 此处 .env > 代码默认 7.2。
USD_TO_CNY_RATE="7.2"

# Coze 集成 (Bot Chat API, POST /v3/chat, PAT 鉴权)
# 注意：当前 Coze PAT 按「能力」存储在 DB（capability.agentConfig.apiKey），不从 env 读取。
# COZE_API_BASE 目前在 coze.adapter.ts 中硬编码为 https://api.coze.cn。
# 以下变量为将来「全局默认 PAT / 国际区切换」预留，尚未被代码读取：
COZE_API_BASE="https://api.coze.cn"   # 预留：中国区；国际区 https://api.coze.com
COZE_PAT=""                            # 预留：全局默认 Personal Access Token (pat_xxx)

# OpenCode Skills Service (独立 HTTP 服务, 参考 opencode-skiills-service)
# 未部署可留空；留空时相关测试端点返回 not_implemented
OPENCODE_API_BASE_URL=""
OPENCODE_API_TOKEN=""

# Redis (for session/cache)
REDIS_URL="redis://localhost:6379"

# ===== Embedding（知识库向量化）=====
EMBEDDING_PROVIDER=openai         # Ollama OpenAI-compatible API
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_KEY=ollama-local
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=120000

# Authentication
# 生产必填：至少 32 位随机值，且不能与 REFRESH_TOKEN_PEPPER 相同
ACCESS_JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Password login risk controls
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# Redis short-window authentication abuse controls
AUTH_RATE_LOGIN_IP_LIMIT=30
AUTH_RATE_LOGIN_IP_WINDOW_SECONDS=300
AUTH_RATE_LOGIN_ACCOUNT_LIMIT=12
AUTH_RATE_LOGIN_ACCOUNT_WINDOW_SECONDS=900
AUTH_RATE_PASSWORD_RESET_EMAIL_LIMIT=3
AUTH_RATE_PASSWORD_RESET_EMAIL_WINDOW_SECONDS=3600
AUTH_RATE_PASSWORD_RESET_IP_LIMIT=10
AUTH_RATE_PASSWORD_RESET_IP_WINDOW_SECONDS=3600
AUTH_RATE_EMAIL_VERIFICATION_USER_LIMIT=3
AUTH_RATE_EMAIL_VERIFICATION_USER_WINDOW_SECONDS=3600
AUTH_RATE_EMAIL_VERIFICATION_IP_LIMIT=10
AUTH_RATE_EMAIL_VERIFICATION_IP_WINDOW_SECONDS=3600
AUTH_RATE_OAUTH_CALLBACK_IP_LIMIT=30
AUTH_RATE_OAUTH_CALLBACK_IP_WINDOW_SECONDS=300
# 生产必填：至少 32 位随机值，且不能与 ACCESS_JWT_SECRET 相同
REFRESH_TOKEN_PEPPER=
REFRESH_COOKIE_NAME=__Host-sep_refresh

# Authentication mail delivery
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=硅基人才平台
WEB_BASE_URL=http://localhost:3000

# Domestic OAuth providers (only enable after configuring the official platform console)
OAUTH_TRANSACTION_TTL_SECONDS=300
WECHAT_OAUTH_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:3001/api/auth/oauth/wechat/callback
QQ_OAUTH_ENABLED=false
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=http://localhost:3001/api/auth/oauth/qq/callback
DINGTALK_OAUTH_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=http://localhost:3001/api/auth/oauth/dingtalk/callback
DINGTALK_SCOPE=openid
