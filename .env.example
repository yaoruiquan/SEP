# Database
DATABASE_URL="postgresql://sep:sep_dev_password@localhost:5432/sep_platform?schema=public"

# JWT
JWT_SECRET="sep-jwt-secret-change-in-production"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:4173"

# sub2api (Token 中转站, OpenAI 兼容端点 —— 所有模型调用走它)
SUB2API_BASE_URL="https://longdaoai.cn/v1"
SUB2API_API_KEY="your-sub2api-key-here"
# 模型 ID 必须是 sub2api 上游实际存在的（GET /v1/models 确认）。
# 注意：默认模型必须支持 function calling，否则带工具的会话会被上游拒绝
# （deepseek-v4-flash 不支持 tools，请求含 tools 时返回 400 Invalid request）。
SUB2API_DEFAULT_MODEL="gemini-3.5-flash"

# 计费汇率：模型单价以 USD 计，入账以 CNY 计。
# 优先级：SystemSetting 表（管理端可改）> 此处 .env > 代码默认 7.2。
USD_TO_CNY_RATE="7.2"

# Coze 集成 (Bot Chat API, POST /v3/chat, PAT 鉴权)
# 注意：当前 Coze PAT 按「能力」存储在 DB（capability.agentConfig.apiKey），不从 env 读取。
# COZE_API_BASE 目前在 coze.adapter.ts 中硬编码为 https://api.coze.cn。
# 以下变量为将来「全局默认 PAT / 国际区切换」预留，尚未被代码读取：
COZE_API_BASE="https://api.coze.cn"   # 预留：中国区；国际区 https://api.coze.com
COZE_PAT=""                            # 预留：全局默认 Personal Access Token (pat_xxx)

# OpenCode Skills Service (独立 HTTP 服务, 参考 opencode-skiills-service)
# 未部署可留空；留空时相关测试端点返回 not_implemented
OPENCODE_API_BASE_URL=""
OPENCODE_API_TOKEN=""

# Redis (for session/cache)
REDIS_URL="redis://localhost:6379"

# ===== Embedding（知识库向量化）=====
EMBEDDING_PROVIDER=openai         # openai | tei | wasm
EMBEDDING_BASE_URL=https://longdaoai.cn
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536
