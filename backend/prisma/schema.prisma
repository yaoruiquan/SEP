// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// User System (用户体系)
// ============================================================================

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  password String // Hashed
  avatar   String?
  /// 全局角色。企业内身份不看这里，看 EnterpriseMember.role。
  /// ADMIN 表示平台运营人员（可访问 (platform) 分组）。
  role     UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions                          ConversationSession[]
  contributedCapabilities           Capability[]               @relation("CapabilityContributor")
  enterpriseReviewedCapabilities    Capability[]               @relation("CapabilityEnterpriseReviewer")
  platformSubmittedCapabilities     Capability[]               @relation("CapabilityPlatformSubmitter")
  /// 企业成员身份。MVP 阶段每个用户恰好一条记录（不做多企业切换），
  /// 但用关联表保留结构能力，将来放开多企业无需数据迁移。
  memberships                       EnterpriseMember[]
  devices                           Device[]
  createdKnowledgeBases             KnowledgeBase[]            @relation("KnowledgeBaseCreator")
  uploadedDocuments                 Document[]                 @relation("DocumentUploader")
  createdTextChunks                 TextChunk[]                @relation("TextChunkCreator")
  notifications                     Notification[]
  createdAnnouncements              Announcement[]             @relation("AnnouncementCreator")
  reviewedSubscriptionRequests      SubscriptionRequest[]      @relation("SubscriptionRequestReviewer")
  userQuotas                        UserQuota[]
  allocatedUserQuotas               UserQuota[]                @relation("UserQuotaAllocator")
  createdSkillVersions              SkillVersion[]             @relation("SkillVersionCreator")
  enterpriseReviewedSkillVersions   SkillVersion[]             @relation("SkillVersionEnterpriseReviewer")
  platformReviewedSkillVersions     SkillVersion[]             @relation("SkillVersionPlatformReviewer")
  skillVersionReviews               SkillVersionReview[]       @relation("SkillVersionReviewer")
  selectedSubscriptionSkillVersions SubscriptionSkillVersion[] @relation("SubscriptionSkillVersionSelector")
  contributionRewardEvents          ContributionRewardEvent[]  @relation("ContributionRewardRecipient")

  @@map("users")
}

enum UserRole {
  USER // B/C端用户
  CONTRIBUTOR // 能力贡献者
  ADMIN // 平台运营方
}

// ============================================================================
// Enterprise Organization (企业组织) —— P0 企业组织基座
// ============================================================================

/// 企业是数据与权限的隔离边界。所有业务数据的归属最终收敛到这里。
model Enterprise {
  id          String  @id @default(cuid())
  name        String
  /// 企业简介、行业等基础资料，MVP 阶段保持简单
  description String? @db.Text
  logo        String?
  /// 运营端元数据：冻结状态、冻结原因等
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  departments          Department[]
  members              EnterpriseMember[]
  subscriptions        Subscription[]
  computeAccount       ComputeAccount?
  computeQuotas        ComputeQuota[]
  userQuotas           UserQuota[]
  subscriptionQuotas   SubscriptionQuota[]
  wallet               EnterpriseWallet?
  knowledgeBases       KnowledgeBase[]
  modelConfig          EnterpriseModelConfig?
  settings             EnterpriseSetting?
  customRoles          CustomRole[]
  apiKeys              EnterpriseApiKey[]
  apiCallLogs          ApiCallLog[]
  invitations          EnterpriseInvitation[]
  orders               Order[]
  cartItems            CartItem[]
  subscriptionRequests SubscriptionRequest[]
  skillVersions        SkillVersion[]
  capabilities         Capability[]
  contributionRewards  ContributionRewardEvent[]

  @@map("enterprises")
}

/// 部门。树形结构，parentId 自引用。
model Department {
  id String @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  name     String
  /// 父部门。为空表示顶级部门。
  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Department[] @relation("DepartmentTree")

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 部门主管（引用 EnterpriseMember）。可为空，由企业管理员设置。
  leaderId String?           @map("leader_id")
  leader   EnterpriseMember? @relation("DepartmentLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  // Relations
  members         EnterpriseMember[]
  grants          EmployeeGrant[]
  knowledgeGrants KnowledgeGrant[]
  modelPolicy     DepartmentModelPolicy?
  invitations     EnterpriseInvitation[]

  @@index([enterpriseId])
  @@index([parentId])
  @@map("departments")
}

/// 企业成员：User × Enterprise 的关联，承载企业内角色与所属部门。
///
/// 为什么用关联表而不是把 enterpriseId + role 塞进 User：
/// MVP 不做多企业切换（每人恰好一条记录），但一旦将来需要
/// "一个人属于多家企业"，塞进 User 就要做数据迁移 + 全量权限改写。
/// 关联表的成本近零，却保留了结构能力。
model EnterpriseMember {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  /// 企业内角色，与 User.role（全局角色）是两套体系
  role EnterpriseRole @default(MEMBER)

  /// 所属部门。为空表示未分配部门（如企业创建者）。
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// 岗位名称，自由文本
  position String?

  /// 自定义角色（Phase 4）。为空表示使用默认角色权限。
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  grants               EmployeeGrant[]
  subscriptionRequests SubscriptionRequest[] @relation("SubscriptionRequestRequester")
  ledDepartments       Department[]          @relation("DepartmentLeader")

  @@unique([userId, enterpriseId])
  @@index([enterpriseId])
  @@index([departmentId])
  @@map("enterprise_members")
}

enum EnterpriseRole {
  ENTERPRISE_ADMIN // 企业管理员：可订阅（花钱）、管组织、审批
  DEPT_MANAGER // 部门负责人：管本部门成员与实例、审批本部门申请
  MEMBER // 普通成员：仅使用被授权的员工，越权需申请
}

/// 企业邀请。管理员生成一次性链接，被邀请人凭 token 注册并直接落地为企业成员。
///
/// 为什么存 tokenHash 而不是明文 token：
/// 邀请链接等同于一次性登录凭证 —— 明文入库意味着数据库泄露即可冒充任意被邀请人。
///
/// 为什么邀请绑定 email：
/// 否则链接被转发后，任何人都能用它加入企业。受邀注册时校验 email 与本记录一致。
///
/// 为什么用 SHA-256 而不是 bcrypt（与 EnterpriseApiKey 的做法不同）：
/// 校验时只有 token、没有 email/企业上下文，必须能"由 token 直接定位记录"。
/// bcrypt 加盐后同一输入哈希不同，无法建唯一索引查询，只能全表扫描逐条 compare。
/// token 是 32 字节 CSPRNG 随机值（非用户口令，无字典可猜），
/// 对抗离线爆破不需要慢哈希，SHA-256 的确定性正是这里需要的。
model EnterpriseInvitation {
  id String @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  /// 被邀请人邮箱。受邀注册时必须与此一致，防止链接转发滥用。
  email String

  /// token 的 SHA-256 十六进制摘要。明文只在创建响应里返回一次。
  tokenHash String @unique

  /// 接受邀请后授予的企业内角色
  role EnterpriseRole @default(MEMBER)

  /// 接受邀请后落入的部门。为空表示不分配。
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// 岗位名称，自由文本
  position String?

  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  /// 发起邀请的 User.id。不建反向关系 —— User 侧无查询场景，避免污染。
  invitedBy String

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  /// 不加 @@unique([enterpriseId, email, status])：
  /// 撤回/过期后再次邀请同一邮箱会撞第二条 REVOKED 记录，等于禁掉重邀。
  /// "同一企业同一邮箱最多一条 PENDING" 是偏序约束，Prisma schema 无法表达
  /// 部分唯一索引，改由 service 层在创建前失效旧 PENDING 记录来保证。
  @@index([enterpriseId, email])
  @@index([enterpriseId, status])
  @@map("enterprise_invitations")
}

enum InvitationStatus {
  PENDING // 待接受
  ACCEPTED // 已接受，已生成 EnterpriseMember
  EXPIRED // 已过期
  REVOKED // 被管理员撤回
}

// ============================================================================
// Digital Employee (硅基员工)
// ============================================================================

model DigitalEmployee {
  id                 String           @id @default(cuid())
  name               String
  description        String           @db.Text
  industry           String // 行业（电商/金融/医疗等）
  position           String // 岗位（运营/客服/数据分析等）
  functionalCategory EmployeeCategory @default(OPERATIONS_ORG)
  avatar             String?
  avatarStyle        String? // 头像风格（adventurer/avataaars/bottts等，来自 DiceBear）

  // Agent Configuration
  systemPrompt String @db.Text // Agent 人设
  modelId      String @default("gpt-4o")
  maxSteps     Int    @default(10)

  // Status
  status EmployeeStatus @default(DRAFT)

  /// 版本号（决策 14：提示式升级需要它）。
  /// 实例订阅时锁定版本，模板发新版后不自动跟进，仅提示企业主动升级。
  version String @default("1.0.0")

  // Pricing (暂时简化，不做复杂计费)
  price Float? // 保留兼容存量数据

  /// 年费（元）。会议示例：5000 元/年
  annualPriceCNY     Decimal? @db.Decimal(12, 2)
  /// 订阅赠送的初始算力额度（元）。会议示例：1000 点 = 1000 元算力
  includedComputeCNY Decimal  @default(0) @db.Decimal(12, 2)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // Relations
  bindings             EmployeeCapabilityBinding[]
  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]
  sessions             ConversationSession[]
  packages             EmployeePackage[]
  orderItems           OrderItem[]
  cartItems            CartItem[]

  @@map("digital_employees")
}

enum EmployeeStatus {
  DRAFT // 草稿
  PENDING // 待审核
  APPROVED // 已审核通过（已上架）
  REJECTED // 已拒绝
  ARCHIVED // 已下架
}

enum EmployeeCategory {
  TECH
  PRODUCT_DESIGN
  MARKETING_GROWTH
  ECOMMERCE
  SALES_CUSTOMER
  OPERATIONS_ORG
  FINANCE_LEGAL
}

// ============================================================================
// Employee Grant (雇佣关系的授权)
// ============================================================================

/// 雇佣关系的授权：企业雇佣的某个员工授权给哪个部门或哪个成员。
///
/// 二者互斥：departmentId 与 memberId 恰有一个非空。
/// 授权给部门 = 该部门所有成员可用；授权给成员 = 仅该成员可用。
model EmployeeGrant {
  id String @id @default(cuid())

  /// 授权所属的雇佣关系（Subscription）。
  /// 曾经指向 EmployeeInstance，2026-08 收敛后直接挂在订阅上 ——
  /// 「企业订阅了某员工」本身即雇佣关系，无需中间的实例对象。
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// 授权对象之一：部门
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// 授权对象之二：具体成员
  memberId String?
  member   EnterpriseMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// 限时授权到期时间。为空表示长期有效。
  /// 跨部门调用申请通过后签发的授权通常带过期时间。
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ 唯一约束不在这里 —— 授权对象二选一，三列必有一列为 NULL，
  /// 而 Postgres 视 NULL 互不相等，`@@unique([subscriptionId, departmentId, memberId])`
  /// 永不生效（实测重复开通返回 201 而非 409）。
  /// 真正的约束是两个**部分唯一索引**，见迁移
  /// `20260813_converge_employee_instance`：
  ///   UNIQUE (subscriptionId, departmentId) WHERE departmentId IS NOT NULL
  ///   UNIQUE (subscriptionId, memberId)     WHERE memberId     IS NOT NULL
  /// Prisma schema 无法表达 WHERE 子句，故不要在此处「补回」@@unique。
  @@index([subscriptionId])
  @@index([departmentId])
  @@index([memberId])
  @@map("employee_grants")
}

enum RequestStatus {
  PENDING // 待审批
  APPROVED // 已批准
  REJECTED // 已驳回
  CANCELED // 申请人撤回
}

// ============================================================================
// Silicon Capability (硅基能力)
// ============================================================================

model Capability {
  id          String         @id @default(cuid())
  name        String
  description String         @db.Text
  type        CapabilityType

  // Classification
  industry String[] // 适用行业
  position String[] // 适用岗位

  // Schema (JSON Schema for input/output validation)
  inputSchema  Json
  outputSchema Json

  // Contributor
  contributorId String
  contributor   User   @relation("CapabilityContributor", fields: [contributorId], references: [id])

  // 企业归属与贡献中心审核边界。历史能力允许为空，迁移期间由旧平台状态兼容。
  enterpriseId String?
  enterprise   Enterprise?          @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  visibility   CapabilityVisibility @default(ENTERPRISE_PRIVATE)

  enterpriseReviewStatus    ContributionReviewStatus @default(NOT_SUBMITTED)
  enterpriseReviewedById    String?
  enterpriseReviewedBy      User?                    @relation("CapabilityEnterpriseReviewer", fields: [enterpriseReviewedById], references: [id], onDelete: SetNull)
  enterpriseReviewedAt      DateTime?
  enterpriseRejectionReason String?                  @db.Text

  platformReviewStatus    ContributionPlatformStatus @default(NOT_SUBMITTED)
  platformSubmittedById   String?
  platformSubmittedBy     User?                      @relation("CapabilityPlatformSubmitter", fields: [platformSubmittedById], references: [id], onDelete: SetNull)
  platformSubmittedAt     DateTime?
  platformRejectionReason String?                    @db.Text

  /// Agent 或无版本能力的最近一次自动校验结果，不包含敏感凭据原文。
  validationResult Json?
  validatedAt     DateTime?

  // Status
  status CapabilityStatus @default(PENDING)

  // Statistics
  usageCount Int    @default(0)
  rating     Float?

  // Metadata (flexible extension)
  metadata Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?

  // Type-specific configs (one-to-one relations)
  agentConfig AgentConfig?
  rpaConfig   RPAConfig?
  skillConfig SkillConfig?
  aiAppConfig AIAppConfig?

  // Relations
  bindings                  EmployeeCapabilityBinding[]
  toolExecutions            ToolExecution[]
  skillVersions             SkillVersion[]
  subscriptionSkillVersions SubscriptionSkillVersion[]
  contributionRewards       ContributionRewardEvent[]

  @@index([enterpriseId, enterpriseReviewStatus])
  @@index([visibility, platformReviewStatus])
  @@map("capabilities")
}

enum CapabilityVisibility {
  ENTERPRISE_PRIVATE
  MARKET_PUBLIC
}

enum ContributionReviewStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum ContributionPlatformStatus {
  NOT_SUBMITTED
  REQUESTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ContributionRewardEventType {
  ENTERPRISE_APPROVED
  PLATFORM_APPROVED
  ENTERPRISE_ADOPTED
  MARKET_ADOPTED
  VALID_USAGE
}

enum ContributionRewardStatus {
  PENDING
  AVAILABLE
  SETTLED
  REVOKED
}

model ContributionRewardEvent {
  id           String                      @id @default(cuid())
  recipientId  String
  recipient    User                        @relation("ContributionRewardRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  enterpriseId String?
  enterprise   Enterprise?                 @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  capabilityId String?
  capability   Capability?                 @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  versionId    String?
  version      SkillVersion?               @relation(fields: [versionId], references: [id], onDelete: SetNull)
  eventType    ContributionRewardEventType
  points       Int                         @default(0)
  amount       Decimal?                    @db.Decimal(18, 6)
  status       ContributionRewardStatus    @default(PENDING)
  dedupeKey    String                      @unique
  metadata     Json?
  createdAt    DateTime                    @default(now())
  settledAt    DateTime?

  @@index([recipientId, status, createdAt])
  @@index([capabilityId, eventType])
  @@map("contribution_reward_events")
}

enum CapabilityType {
  AGENT // 智能体（Coze/Dify/N8N/OpenCode）
  RPA // RPA 工作流
  SKILL // 提示词模板 + LLM
  AI_APP // AI 应用（Web/API）
}

enum CapabilityStatus {
  PENDING // 待审核
  APPROVED // 已通过
  REJECTED // 已拒绝
}

// ============================================================================
// Capability Type-Specific Configs (分表存储类型特定配置)
// ============================================================================

model AgentConfig {
  id           String     @id @default(cuid())
  capabilityId String     @unique
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  platform AgentPlatform // coze | dify | n8n | opencode

  // Coze-specific fields
  region      String? // CN | GLOBAL (Coze 区域)
  runtimeKind String? // BOT_CHAT | WORKFLOW (Coze 运行类型)
  botId       String? // Coze Bot ID
  workflowId  String? // Coze Workflow ID

  // Other platform-specific fields
  apiKey      String? // Coze PAT / Dify API Key (encrypted)
  workflowUrl String? // N8N Webhook URL
  webUrl      String? // Web URL (for iframe/redirect)
  skillName   String? // OpenCode skill name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_configs")
}

enum AgentPlatform {
  COZE
  DIFY
  N8N
  OPENCODE
}

model RPAConfig {
  id           String     @id @default(cuid())
  capabilityId String     @unique
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  platform      RPAPlatform // 实在 | 影刀
  executionMode RPAExecutionMode

  // Package info
  packageUrl    String? // OSS URL for RPA package
  packageSha256 String? // Package integrity check
  configDoc     String? @db.Text // Configuration documentation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rpa_configs")
}

enum RPAPlatform {
  SHIZAI // 实在智能
  YINGDAO // 影刀
}

enum RPAExecutionMode {
  DOWNLOAD // 下载模式（用户手动导入）
  CLOUD // 云端执行
  CLIENT // 客户端执行
}

model SkillConfig {
  id           String     @id @default(cuid())
  capabilityId String     @unique
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  // Prompt template
  template String @db.Text

  // Model configuration
  modelId     String @default("gpt-4o-mini")
  temperature Float  @default(0.7)
  maxTokens   Int    @default(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skill_configs")
}

enum SkillVersionScope {
  PLATFORM
  ENTERPRISE
}

enum SkillVersionStatus {
  DRAFT
  PENDING_ENTERPRISE_REVIEW
  ENTERPRISE_APPROVED
  PENDING_PLATFORM_REVIEW
  PLATFORM_APPROVED
  ENTERPRISE_REJECTED
  PLATFORM_REJECTED
  ARCHIVED
}

model SkillVersion {
  id           String            @id @default(cuid())
  capabilityId String
  capability   Capability        @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  scope        SkillVersionScope

  enterpriseId String?
  enterprise   Enterprise? @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  parentVersionId String?
  parentVersion   SkillVersion?  @relation("SkillVersionFork", fields: [parentVersionId], references: [id], onDelete: SetNull)
  forkedVersions  SkillVersion[] @relation("SkillVersionFork")

  /// 企业版本提交平台时创建独立副本，不改变原企业版本归属。
  sourceVersionId  String?        @unique
  sourceVersion    SkillVersion?  @relation("SkillVersionPromotion", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  promotedVersions SkillVersion[] @relation("SkillVersionPromotion")

  version       String
  content       String             @db.Text
  changeSummary String?            @db.Text
  status        SkillVersionStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation("SkillVersionCreator", fields: [createdById], references: [id])

  submittedAt DateTime?

  enterpriseReviewedById String?
  enterpriseReviewedBy   User?     @relation("SkillVersionEnterpriseReviewer", fields: [enterpriseReviewedById], references: [id], onDelete: SetNull)
  enterpriseReviewedAt   DateTime?

  platformReviewedById String?
  platformReviewedBy   User?     @relation("SkillVersionPlatformReviewer", fields: [platformReviewedById], references: [id], onDelete: SetNull)
  platformReviewedAt   DateTime?

  rejectionReason String? @db.Text

  /// 最近一次自动校验结果；仅用于审核门禁与审计展示，不包含密钥原文。
  validationResult Json?
  validatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews             SkillVersionReview[]
  selections          SubscriptionSkillVersion[]
  defaultBindings     EmployeeCapabilityBinding[] @relation("DefaultSkillVersion")
  contributionRewards ContributionRewardEvent[]

  @@index([capabilityId, status])
  @@index([enterpriseId, status])
  @@index([parentVersionId])
  @@map("skill_versions")
}

enum SkillReviewActorType {
  ENTERPRISE
  PLATFORM
}

enum SkillReviewDecision {
  APPROVE
  REJECT
}

model SkillVersionReview {
  id         String               @id @default(cuid())
  versionId  String
  version    SkillVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade)
  actorType  SkillReviewActorType
  decision   SkillReviewDecision
  reviewerId String
  reviewer   User                 @relation("SkillVersionReviewer", fields: [reviewerId], references: [id])
  comment    String?              @db.Text
  createdAt  DateTime             @default(now())

  @@index([versionId, createdAt])
  @@map("skill_version_reviews")
}

model AIAppConfig {
  id           String     @id @default(cuid())
  capabilityId String     @unique
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  integrationMode AIAppIntegrationMode

  apiUrl String? // API endpoint
  webUrl String? // Web URL (for iframe/redirect)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_app_configs")
}

enum AIAppIntegrationMode {
  API // HTTP API 调用
  IFRAME // iframe 嵌入
  REDIRECT // 跳转
}

// ============================================================================
// Binding Relationship (绑定关系)
// ============================================================================

model EmployeeCapabilityBinding {
  id String @id @default(cuid())

  employeeId String
  employee   DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  /// 平台员工模板默认使用的技能版本；企业实际选版存 SubscriptionSkillVersion。
  defaultSkillVersionId String?
  defaultSkillVersion   SkillVersion? @relation("DefaultSkillVersion", fields: [defaultSkillVersionId], references: [id], onDelete: SetNull)

  // 绑定配置
  priority Int     @default(0) // 优先级（0-100）
  enabled  Boolean @default(true) // 是否启用
  config   Json? // 能力配置（JSON）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, capabilityId])
  @@index([employeeId])
  @@index([capabilityId])
  @@index([defaultSkillVersionId])
  @@map("employee_capability_bindings")
}

// ============================================================================
// Subscription (雇佣关系)
// ============================================================================

/// 订阅 = 雇佣关系。主体是【企业】而非个人 —— 订阅要花企业的钱，
/// 只有企业管理员能发起（其他角色走 SubscriptionRequest 申请）。
///
/// 2026-08 收敛：原先「订阅 → EmployeeInstance → 授权」三层，中间的实例
/// 对象除了当权限锚点外无实际职责（name/departmentId/config 均无写入路径，
/// status 与订阅状态语义重叠），故并入本模型。企业雇佣了某个员工，
/// 这条雇佣关系本身即权限锚点。
model Subscription {
  id String @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  employeeId String
  employee   DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  status SubscriptionStatus @default(ACTIVE)

  /// 雇佣时锁定的模板版本。
  /// 必须存版本而非只读模板当前版本 —— 否则无法实现「提示式升级」
  /// （模板发新版不自动跟进，仅提示企业主动确认）。
  templateVersion String

  /// 企业内自定义称呼，如「小助手」。为空则展示模板名称。
  name String?

  startDate DateTime  @default(now())
  endDate   DateTime?

  // 企业侧订阅配置
  config Json?

  /// 新增：钱包支付记录
  walletTransactionId String? @unique // 关联扣款记录

  /// 新增：终止信息
  terminatedAt        DateTime?
  terminatedBy        String? // 操作人 userId
  terminatedReason    String? // 'trial_refund'（试用期退款）, 'user_cancel'（用户主动）
  refundAmount        Decimal?  @db.Decimal(10, 2) // 退款金额
  refundTransactionId String?   @unique // 退款交易记录

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  grants                 EmployeeGrant[]
  knowledgeGrants        KnowledgeGrant[]
  fromRequests           SubscriptionRequest[]
  subscriptionQuota      SubscriptionQuota?
  skillVersionSelections SubscriptionSkillVersion[]

  /// 一个企业对同一员工只雇佣一次。收敛后这条约束即是「一员工一雇佣关系」
  /// 的全部含义 —— 部门差异化由 KnowledgeGrant.departmentId 表达，
  /// 而非开多份雇佣关系。
  @@unique([enterpriseId, employeeId])
  @@index([enterpriseId])
  @@map("subscriptions")
}

model SubscriptionSkillVersion {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  capabilityId   String
  capability     Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  versionId      String
  version        SkillVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  selectedById   String
  selectedBy     User         @relation("SubscriptionSkillVersionSelector", fields: [selectedById], references: [id])
  selectedAt     DateTime     @default(now())

  @@unique([subscriptionId, capabilityId])
  @@index([subscriptionId])
  @@index([versionId])
  @@map("subscription_skill_versions")
}

/// 使用申请（原「订阅申请」）。普通员工申请使用某硅基员工。
/// kind=SUBSCRIBE 时审批通过后创建订阅并授权；kind=GRANT 时企业已订阅，审批通过后仅授权。
model SubscriptionRequest {
  id String @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  /// 申请人（企业成员）。成员被移出企业后置为 NULL。
  requesterId String?
  requester   EnterpriseMember? @relation("SubscriptionRequestRequester", fields: [requesterId], references: [id], onDelete: SetNull)

  /// 申请人身份快照（成员被移除后回填）
  requesterEmail String?
  requesterName  String?

  /// 申请订阅的硅基员工模板
  employeeId String
  employee   DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// 申请理由 / 使用场景说明
  reason String? @db.Text

  /// 期望订阅时长（天），null = 永久
  requestedDays Int?

  /// 申请类型：SUBSCRIBE=企业尚未订阅（审批通过后订阅+授权，扣费）；
  /// GRANT=企业已订阅（审批通过后仅授权，免费）。由后端按当时订阅状态自动判定。
  kind SubscriptionRequestKind @default(SUBSCRIBE)

  status RequestStatus @default(PENDING)

  /// 审批人（企业管理员或平台管理员）
  reviewerId String?
  reviewer   User?     @relation("SubscriptionRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote String?   @db.Text
  reviewedAt DateTime?

  /// 审批通过后创建的订阅 ID（用于追溯）
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enterpriseId])
  @@index([requesterId])
  @@index([employeeId])
  @@index([status])
  @@map("subscription_requests")
}

/// 订阅申请的类型：区分「申请订阅新员工」与「申请使用已订阅员工」。
/// 两条审批流已收敛到同一张 subscription_requests 表，靠本字段区分展示与审批后果。
enum SubscriptionRequestKind {
  SUBSCRIBE // 企业尚未订阅该员工 → 审批通过后订阅（扣费）+ 授权
  GRANT // 企业已订阅该员工 → 审批通过后仅授权（免费）
}

/// 原 InstanceStatus 的四态并入此处：
///   PENDING_ACTIVATION → ACTIVE（雇佣关系存在即生效）
///   SUSPENDED          → PAUSED
///   REVOKED            → EXPIRED
enum SubscriptionStatus {
  ACTIVE // 激活
  PAUSED // 暂停（企业主动停用）
  EXPIRED // 过期 / 已退订
  TERMINATED // 已解雇（新增：明确区分主动解雇与自然过期）
}

// ============================================================================
// Conversation (对话)
// ============================================================================

model ConversationSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId String
  employee   DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title  String? // 自动生成或用户修改
  status SessionStatus @default(ACTIVE)

  // 会话级模型覆盖：null 时用 employee.modelId
  modelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages           Message[]
  toolExecutions     ToolExecution[]
  knowledgeUsageLogs KnowledgeUsageLog[]

  @@map("conversation_sessions")
}

enum SessionStatus {
  ACTIVE // 活跃
  ARCHIVED // 归档
}

model Message {
  id String @id @default(cuid())

  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String      @db.Text

  // Tool calls (if role is assistant and made tool calls)
  toolCalls Json?

  // Knowledge sources (RAG - stores retrieved knowledge chunks used in this response)
  knowledgeSources Json?

  // 多模态附件（用户消息）：[{ type, key, url, name, size, mimeType }]
  // key 是存储对象的永久标识，url 是签名链接（有时效），过期后按 key 重签
  attachments Json?

  // Token usage (for billing)
  inputTokens  Int?
  outputTokens Int?

  // 实际使用的模型（用于计费追溯和成本分析）
  modelId String?

  // 本条消息的成本（人民币，元）
  // 计算公式：(inputTokens * pricingInputPer1M + outputTokens * pricingOutputPer1M) / 1,000,000
  cost Decimal? @db.Decimal(10, 6)

  // 多员工协作：记录实际处理该消息的员工 ID（如果切换了员工）
  metadata Json?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("messages")
}

enum MessageRole {
  USER // 用户消息
  ASSISTANT // AI 助手消息
  TOOL // Tool 执行结果
}

model ToolExecution {
  id String @id @default(cuid())

  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id])

  input  Json
  output Json?

  duration   Int? // 执行耗时（ms）
  tokensUsed Int? // Token 消耗（如适用）

  status       ExecutionStatus @default(SUCCESS)
  errorMessage String?         @db.Text

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("tool_executions")
}

enum ExecutionStatus {
  SUCCESS
  FAILED
}

// ============================================================================
// Unified Wallet (统一钱包) - Phase 1
// ============================================================================

/// 企业钱包：统一的资金池，所有充值、订阅、算力消费都从这里扣款。
model EnterpriseWallet {
  id           String @id @default(cuid())
  enterpriseId String @unique

  /// 可用余额（使用 Decimal 避免浮点精度问题）
  balance Decimal @default(0) @db.Decimal(10, 2)

  /// 冻结金额（退款处理中、订单待支付等）
  frozenAmount Decimal @default(0) @db.Decimal(10, 2)

  /// 乐观锁版本号（防止并发余额错乱）
  version Int @default(0)

  /// 累计统计（只增不减，用于展示）
  totalDeposit Decimal @default(0) @db.Decimal(10, 2) // 累计充值
  totalConsume Decimal @default(0) @db.Decimal(10, 2) // 累计消费
  totalRefund  Decimal @default(0) @db.Decimal(10, 2) // 累计退款

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enterprise   Enterprise          @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("enterprise_wallets")
}

/// 钱包交易记录：每笔收支都有明确记录，带余额快照用于审计。
model WalletTransaction {
  id       String @id @default(cuid())
  walletId String

  /// 交易类型
  type WalletTransactionType

  /// 交易金额（正数=入账，负数=出账）
  amount Decimal @db.Decimal(10, 2)

  /// 交易前后余额快照（审计用）
  balanceBefore Decimal @db.Decimal(10, 2)
  balanceAfter  Decimal @db.Decimal(10, 2)

  /// 关联业务实体
  relatedType String? // 'subscription', 'compute', 'payment_order'
  relatedId   String? // 订阅 ID / 支付订单 ID

  /// 支付相关
  paymentMethod  String? // 'alipay', 'wechat', 'balance'
  paymentOrderId String? @unique

  /// 描述和元数据
  description String? // 人类可读描述："订阅【内容营销专员】"
  metadata    Json? // 扩展信息

  createdAt DateTime @default(now())
  createdBy String? // 操作人 userId（管理员调整时记录）

  wallet EnterpriseWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([relatedType, relatedId])
  @@index([paymentOrderId])
  @@map("wallet_transactions")
}

enum WalletTransactionType {
  DEPOSIT // 充值（支付宝入账）
  CONSUME // 消费（订阅员工、算力消耗）
  REFUND // 退款（解雇员工、取消订阅）
  ADJUSTMENT // 调整（管理员手动调整）
  FREEZE // 冻结（预留）
  UNFREEZE // 解冻（预留）
}

/// 支付订单：充值、订阅支付的订单记录。
model PaymentOrder {
  id           String @id @default(cuid())
  enterpriseId String

  /// 订单号
  orderNo String  @unique // 平台订单号（自己生成）
  tradeNo String? @unique // 支付宝交易号（回调时填充）

  /// 金额和状态
  amount Decimal       @db.Decimal(10, 2)
  status PaymentStatus
  method PaymentMethod // 'alipay', 'wechat'

  /// 业务类型
  businessType String // 'recharge'（纯充值）, 'subscription'（订阅支付）
  relatedId    String? // 如果是订阅支付，关联订阅 ID

  /// 支付宝回调数据
  notifyData Json?
  notifyTime DateTime?

  /// 时间戳
  createdAt DateTime  @default(now())
  paidAt    DateTime?
  closedAt  DateTime?

  @@index([enterpriseId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payment_orders")
}

enum PaymentStatus {
  PENDING // 待支付（已创建，等待支付宝回调）
  PAID // 已支付（回调成功，已入账）
  FAILED // 支付失败
  REFUNDING // 退款中
  REFUNDED // 已退款
  CLOSED // 已关闭（超时未支付）
}

enum PaymentMethod {
  ALIPAY // 支付宝
  WECHAT // 微信支付
  BALANCE // 余额支付（预留）
}

// ============================================================================
// Compute Platform (算力平台) - 保留兼容
// ============================================================================

/// 算力账户。主体是【企业】—— 套餐含算力额度，按企业结算。
///
/// ⚠️ 收敛后余额统一到 EnterpriseWallet，此表保留用于统计和历史记录。
/// ⚠️ 多租户隔离要点：ComputeTransaction 自身没有 enterpriseId，
/// 必须经 accountId → ComputeAccount.enterpriseId 校验归属，
/// 否则拿到别家的 accountId 就能查别家账单。
model ComputeAccount {
  id String @id @default(cuid())

  enterpriseId String     @unique
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  /// ⚠️ 废弃字段（保留兼容），真实余额从 EnterpriseWallet.balance 读取
  balance Float @default(0) // 余额（人民币）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions   ComputeTransaction[]
  rechargeOrders RechargeOrder[]

  @@map("compute_accounts")
}

// ============================================================================
// Enterprise Compute Allocation (企业算力分配体系)
// ============================================================================

/// 用户个人配额（碳基员工）
/// 管理员从企业可分配池中为成员分配的 token 预算。
/// 当前硅基员工的订阅赠送额度不足后，才从这里扣除。
model UserQuota {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  totalTokens Int // 分配的总量
  usedTokens  Int    @default(0)
  status      String @default("ACTIVE") // ACTIVE | EXHAUSTED

  allocatedAt DateTime @default(now()) // 分配时间
  allocatedBy String? // 分配者（管理员 userId）
  allocator   User?    @relation("UserQuotaAllocator", fields: [allocatedBy], references: [id], onDelete: SetNull)
  notes       String?  @db.Text // 分配备注

  transactions ComputeTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, enterpriseId])
  @@index([userId])
  @@index([enterpriseId, status])
  @@map("user_quotas")
}

/// 订阅配额（硅基员工自带）
/// 订阅创建时自动生成，只用于该订阅对应硅基员工的对话，优先消耗。
model SubscriptionQuota {
  id             String       @id @default(cuid())
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  totalTokens Int // 订阅自带的token量
  usedTokens  Int    @default(0)
  status      String @default("ACTIVE") // ACTIVE | EXHAUSTED

  transactions ComputeTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([enterpriseId, status])
  @@map("subscription_quotas")
}

/// 企业可分配池
/// 企业购买的 token 池，由管理员分配给碳基员工；不参与对话自动扣减。
model ComputeQuota {
  id           String     @id @default(cuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  type        String // STANDARD | PREMIUM | CUSTOM (FREE移除，改为UserQuota)
  totalTokens Int // 配额总量
  usedTokens  Int    @default(0)

  expiresAt DateTime? // null = 永久有效
  status    String    @default("ACTIVE") // ACTIVE | EXPIRED | EXHAUSTED
  priority  Int       @default(2) // 企业池固定为priority=2

  transactions ComputeTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enterpriseId, status])
  @@map("compute_quotas")
}

model ComputeTransaction {
  id String @id @default(cuid())

  accountId String
  account   ComputeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type   TransactionType
  amount Float // 正数=充值，负数=消费

  // 关联信息
  sessionId String? // 如果是对话消费，关联会话

  // 三级配额关联（互斥，只能关联一个）
  quotaId             String? // 企业配额池ID
  quota               ComputeQuota?      @relation(fields: [quotaId], references: [id], onDelete: SetNull)
  userQuotaId         String? // 用户个人配额ID
  userQuota           UserQuota?         @relation(fields: [userQuotaId], references: [id], onDelete: SetNull)
  subscriptionQuotaId String? // 订阅配额ID
  subscriptionQuota   SubscriptionQuota? @relation(fields: [subscriptionQuotaId], references: [id], onDelete: SetNull)

  quotaTier String? // USER | SUBSCRIPTION | ENTERPRISE (标注从哪一级扣的)
  quotaType String? // 配额类型显示名，如 "李明个人配额" / "市场调研员订阅配额" / "STANDARD企业池"

  tokens Int? // 本次消费的 token 数（老数据可为 null）

  description String?
  metadata    Json?   @db.JsonB

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([quotaId])
  @@index([userQuotaId])
  @@index([subscriptionQuotaId])
  @@map("compute_transactions")
}

enum TransactionType {
  RECHARGE // 充值
  CONSUME // 消费
  REFUND // 退款
}

// ============================================================================
// System Settings (系统配置 - key/value)
// ----------------------------------------------------------------------------
// 存运行时可配的系统级设置，如 sub2api 上游 BASE_URL / API_KEY。
// 运行时优先读本表，缺失时回退 .env。敏感值（isSecret=true）加密存储，
// 接口永不回传明文。
// ============================================================================
model SystemSetting {
  id String @id @default(cuid())

  key      String  @unique // 如 SUB2API_BASE_URL / SUB2API_API_KEY
  value    String  @db.Text // 明文或密文（isSecret 决定）
  isSecret Boolean @default(false)
  label    String? // 界面显示名
  category String  @default("general") // 分组，如 sub2api

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ============================================================================
// Platform Model (平台启用模型白名单)
// ----------------------------------------------------------------------------
// 上游 sub2api 有几十个模型，但并非都适合对用户开放（图像模型、preview 版本、
// 内部工具模型等）。本表是「平台对用户开放的模型集合」：
//   - 管理员点「同步上游」→ 上游模型入库（新的默认 enabled=false，需手动启用）
//   - 上游已下架的模型不物理删除，标记 isStale，保留历史引用可读
//   - enabled=false 即软禁用：用户端选不到，但历史会话仍能显示模型名
// ============================================================================
model PlatformModel {
  id String @id @default(cuid())

  modelId   String  @unique
  label     String
  enabled   Boolean @default(false)
  sortOrder Int     @default(0)

  lastSeenAt DateTime @default(now())
  isStale    Boolean  @default(false)

  // 扩展元数据
  contextLength      Int? // 上下文长度（tokens）
  maxOutputTokens    Int? // 最大输出长度
  supportedFeatures  Json? // 支持的功能 {functionCalling, vision, streaming}
  pricingInputPer1M  Decimal? @db.Decimal(10, 4) // 输入价格（元/1M tokens）
  pricingOutputPer1M Decimal? @db.Decimal(10, 4) // 输出价格（元/1M tokens）
  description        String? // 模型说明
  vendor             String? // 厂商（OpenAI, Anthropic, Google, etc.）
  category           String? // 分类（chat, code, vision, embedding）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
  @@map("platform_models")
}

// ============================================================================
// Employee Package（员工包）
// ----------------------------------------------------------------------------
// 运营上传对应版本的 ZIP 包，企业成员下载后本地部署即可使用。
// version 与 DigitalEmployee.version 对应 —— 运营发版时同步更新两处：
//   1. 此处的 EmployeePackage 行（新上传的文件）
//   2. DigitalEmployee.version（触发已有实例的 upgradeAvailable 提示）
//
// 下载权限：调用方在本企业对该员工模板的**任意一个 ACTIVE 实例**有有效授权，
// 即可下载。授权的两条路径（直接/部门）都算，过期授权不算。
// 平台运营（UserRole.ADMIN）无需授权直接可下载（用于测试验包）。
// ============================================================================
model EmployeePackage {
  id String @id @default(cuid())

  employeeId String
  employee   DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// 发布时对应的 DigitalEmployee.version，用于在下载 UI 上显示版本号
  version String

  /// 原始文件名（ZIP 上传时携带）
  filename String?

  /// 服务器存储路径（相对 PACKAGE_STORAGE_PATH）
  storagePath String?

  /// SHA-256 十六进制
  sha256 String?

  fileSizeBytes Int?

  /// pi package 引用（决策 5：复用 pi 自己的 package 机制）。
  /// 与 ZIP 字段互斥也可并存：没有 npm 包时只填 ZIP；两者都有时客户端优先用这个。
  /// { type: "npm" | "git", spec: "@sep/employee-video@1.2.0" }
  packageRef Json?

  /// 上传者（平台运营账号的 User.id）
  uploadedBy String

  /// 可选的更新说明（一句话）
  changelog String?

  createdAt DateTime @default(now())

  @@index([employeeId, createdAt(sort: Desc)])
  @@map("employee_packages")
}

// ============================================================================
// Device (客户端设备)
// ============================================================================

model Device {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 客户端生成的设备指纹（如 OS + CPU + 主板序列号的哈希）
  fingerprint   String
  platform      String // darwin / win32 / linux
  clientVersion String?
  lastSeenAt    DateTime  @default(now()) @updatedAt
  revokedAt     DateTime? // 运营吊销后设置
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("devices")
}

// ============================================================================
// Knowledge Base (企业知识库 - MVP 空壳实现)
// ============================================================================

model KnowledgeBase {
  id           String   @id @default(cuid())
  enterpriseId String
  name         String
  description  String?  @db.Text
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enterprise Enterprise           @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  creator    User                 @relation("KnowledgeBaseCreator", fields: [createdBy], references: [id])
  documents  Document[]
  grants     KnowledgeGrant[]
  textChunks TextChunk[]
  usageLogs  KnowledgeUsageLog[]
  searchLogs KnowledgeSearchLog[]

  @@index([enterpriseId])
  @@map("knowledge_bases")
}

model Document {
  id              String         @id @default(cuid())
  knowledgeBaseId String
  filename        String
  originalName    String
  fileSize        Int
  mimeType        String
  storagePath     String // 本地文件路径
  status          DocumentStatus @default(PENDING)
  uploadedBy      String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Phase 2 新增：处理增强字段（均为可空，保持向后兼容）
  version        Int       @default(1)
  lastError      String?   @db.Text
  processedAt    DateTime?
  embeddingModel String? // 向量化时使用的模型 ID，用于追溯

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  uploader      User          @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  chunks        TextChunk[] // Phase 2: 反向关联生成的文本片段

  @@index([knowledgeBaseId])
  @@index([knowledgeBaseId, status]) // 批量查询状态时加速
  @@map("documents")
}

enum DocumentStatus {
  PENDING // 等待处理
  PROCESSING // 处理中（Phase 2 新增）
  READY // 处理完成，可检索
  FAILED // 失败，可重试
}

// ============================================================================
// Knowledge Search Log (检索日志 - Phase 2)
// ----------------------------------------------------------------------------
// 记录每次检索（含测试检索 isTest=true），用于分析命中率和零命中查询。
// ============================================================================

model KnowledgeSearchLog {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  enterpriseId    String
  query           String   @db.Text
  topK            Int
  hitCount        Int // 实际返回的结果数量
  topScore        Float? // 最高相似度分数
  strategy        String   @default("vector") // "vector" | "fulltext" | "hybrid"
  isTest          Boolean  @default(false) // true = 来自测试工具，false = 来自实际会话
  durationMs      Int? // 检索耗时（ms）
  createdAt       DateTime @default(now())

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId, createdAt])
  @@index([enterpriseId, createdAt])
  @@map("knowledge_search_logs")
}

/// 知识库授权：某知识库对哪个雇佣关系 / 哪个部门可见。
///
/// 两个维度可以叠加使用，语义是「交集」而非「并集」：
///   - 只填 subscriptionId：该员工在全企业范围内都能检索这个知识库
///   - subscriptionId + departmentId：该员工仅在该部门成员使用时才能检索
///
/// 部门维度是收敛掉 EmployeeInstance 后承接「部门差异化」的方式 ——
/// 从前靠给同一模板开多个实例、各挂各的知识库来实现，现在一份雇佣关系
/// 配多条带部门的授权即可，不必维护多份雇佣关系。
model KnowledgeGrant {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  subscriptionId  String?
  departmentId    String?
  createdAt       DateTime @default(now())

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  department    Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// ⚠️ 不加 @@unique —— Postgres 视 NULL 互不相等，带可空列的复合唯一
  /// 在对应列为 NULL 时永不触发。真正覆盖「同一知识库 + 同一雇佣关系 + 同一
  /// 部门」唯一性的是迁移 `20260813_converge_employee_instance` 里的三个
  /// 部分唯一索引（WHERE subscriptionId IS NOT NULL / WHERE departmentId IS NOT NULL）。
  @@index([knowledgeBaseId])
  @@index([subscriptionId])
  @@index([departmentId])
  @@map("knowledge_grants")
}

model TextChunk {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  documentId      String? // Phase 2: 关联文档（手动创建为 null）
  title           String?
  content         String   @db.Text
  source          String // "manual" or document ID
  tags            String[] // User-defined tags

  // Phase 2: Vector + Lexical fields
  // Legacy compatibility column. New vector search uses embeddingVector.
  embedding      Bytes?
  embeddingVector Unsupported("vector(1024)")?
  embeddingModel String? // bge-m3:latest
  tokens         String[] // 预分词结果，用于 BM25

  vectorId  String? // 外部向量库 ID（Phase 1 遗留，Phase 2 不用）
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document      Document?     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator       User?         @relation("TextChunkCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([knowledgeBaseId])
  @@index([documentId])
  @@map("text_chunks")
}

model KnowledgeUsageLog {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  sessionId       String
  query           String   @db.Text
  retrievedChunks Int
  createdAt       DateTime @default(now())

  knowledgeBase KnowledgeBase       @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  session       ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@index([sessionId])
  @@map("knowledge_usage_logs")
}

// ============================================================================
// Notification (实时通知)
// ============================================================================

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String           @db.Text
  relatedType String? // 'subscription' | 'task' | 'instance' | 'balance'
  relatedId   String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, read])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SUBSCRIPTION_REQUEST_CREATED
  SUBSCRIPTION_REQUEST_APPROVED
  SUBSCRIPTION_REQUEST_REJECTED
}

// ============================================================================
// Enterprise Model Config (企业模型配置中心 - Phase 1)
// ============================================================================

/// 企业级模型与预算配置。每家企业最多一条，不存在时所有字段退回系统默认。
model EnterpriseModelConfig {
  id           String @id @default(cuid())
  enterpriseId String @unique

  // 会话模型
  defaultChatModel     String   @default("gemini-3.5-flash-high")
  /// 允许使用的模型白名单。空数组 = 继承平台全部 enabled 模型。
  allowedChatModels    String[] @default([])
  /// 是否允许成员在会话中手动切换模型
  allowUserSwitchModel Boolean  @default(true)

  // 知识库向量化设置
  embeddingModel     String  @default("bge-m3:latest")
  rerankModel        String?
  embeddingBatchSize Int     @default(32)
  embeddingTimeoutMs Int     @default(30000)

  // 员工模型策略
  /// FOLLOW_TEMPLATE = 使用员工模板的 modelId；FORCE_DEFAULT = 强制使用 defaultChatModel
  employeeModelPolicy  String  @default("FOLLOW_TEMPLATE")
  employeeDefaultModel String?

  // 月度预算控制
  monthlyBudgetCNY Decimal? @db.Decimal(12, 2)
  /// 触发告警的预算使用率，默认 80%
  alertThreshold   Float    @default(0.8)
  /// 超预算后是否硬性阻断新会话
  hardStopOnBudget Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enterprise Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@map("enterprise_model_configs")
}

// ============================================================================
// Phase 4: Enterprise Settings / Custom Roles / API Keys
// ============================================================================

/// 企业安全与集成设置。每家企业最多一条。
model EnterpriseSetting {
  id           String @id @default(cuid())
  enterpriseId String @unique

  // 内容安全
  sensitiveWordsEnabled Boolean  @default(false)
  sensitiveWords        String[] @default([])

  // 网络安全
  ipWhitelist String[] @default([])

  // 会话安全
  sessionTimeoutMinutes     Int  @default(480)
  forcePasswordRotationDays Int?

  // Webhook
  webhookUrl    String?
  webhookSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enterprise Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@map("enterprise_settings")
}

/// 企业自定义角色，用于精细化权限控制。
model CustomRole {
  id           String @id @default(cuid())
  enterpriseId String

  name        String
  description String?
  permissions String[] @default([])
  /// 内置角色（平台预置，企业只读）
  isBuiltin   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enterprise Enterprise         @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  members    EnterpriseMember[]

  @@unique([enterpriseId, name])
  @@map("custom_roles")
}

/// 企业 API Key，用于程序化接入。Key 仅在创建时明文返回一次，存储 bcrypt 哈希。
model EnterpriseApiKey {
  id           String @id @default(cuid())
  enterpriseId String

  name      String
  /// 前缀，用于列表展示（如 sk-ent-xxxx）
  keyPrefix String
  /// bcrypt 哈希，不可逆
  keyHash   String
  scopes    String[] @default([])

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdBy String
  createdAt DateTime @default(now())

  enterprise Enterprise   @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  logs       ApiCallLog[]

  @@index([enterpriseId])
  @@map("enterprise_api_keys")
}

/// API 调用日志，用于审计与用量统计。
model ApiCallLog {
  id           String @id @default(cuid())
  enterpriseId String

  apiKeyId   String?
  method     String
  path       String
  statusCode Int
  durationMs Int
  ip         String?

  createdAt DateTime @default(now())

  enterprise Enterprise        @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  apiKey     EnterpriseApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([enterpriseId, createdAt])
  @@map("api_call_logs")
}

// ============================================================================
// Cost Analytics (成本归因分析)
// ============================================================================

/// 按天预聚合的成本数据，避免全表扫描 messages。
/// 由 CostAnalyticsCronService 每小时增量更新（当天），每日 00:30 固化前一天。
/// enterpriseId + departmentId + subscriptionId + modelId + date 五元组唯一。
model CostDailyRollup {
  id             String   @id @default(cuid())
  enterpriseId   String
  /// 若消息来自归属某部门的用户，此处非空
  departmentId   String?
  /// 产生该成本的雇佣关系。收敛前此列名为 employeeInstanceId 且恒为 null
  /// （会话从未挂过实例）；现在由 (enterpriseId, employeeId) 直接定位雇佣关系，
  /// 可以真正回填。
  subscriptionId String?
  modelId        String
  /// 精确到「日」的 Date（UTC 00:00:00）
  date           DateTime @db.Date

  inputTokens  BigInt  @default(0)
  outputTokens BigInt  @default(0)
  /// 精度：12 位整数，4 位小数（人民币，元）
  costCNY      Decimal @db.Decimal(12, 4)
  messageCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enterpriseId, departmentId, subscriptionId, modelId, date])
  @@index([enterpriseId, date])
  @@map("cost_daily_rollups")
}

/// 部门级模型策略覆盖，优先级高于企业级配置。
model DepartmentModelPolicy {
  id                String   @id @default(cuid())
  departmentId      String   @unique
  defaultChatModel  String?
  allowedChatModels String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("department_model_policies")
}

// ============================================================================
// Order & Cart (订单与购物车)
// ============================================================================

/// 订单状态
enum OrderStatus {
  PENDING // 待支付
  PAID // 已支付
  CLOSED // 已关闭（超时/取消）
  REFUNDED // 已退款
}

/// 充值订单状态
enum RechargeOrderStatus {
  PENDING // 待支付
  PAID // 已支付
  CLOSED // 已关闭（超时/取消）
}

/// 支付渠道
enum PayChannel {
  ALIPAY // 支付宝
  WECHAT // 微信支付
  BALANCE // 企业余额
  MANUAL // 线下/手动
}

/// 订单：企业购买数字员工的订单记录
model Order {
  id String @id @default(cuid())

  /// 订单号（业务唯一标识，用于对外展示和支付回调匹配）
  orderNo String @unique

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  /// 下单人（EnterpriseMember.id 或 User.id，这里简化存 User.id）
  createdBy String

  status OrderStatus @default(PENDING)

  /// 订单总金额（元）
  totalAmount Decimal @db.Decimal(12, 2)

  /// 支付渠道
  payChannel PayChannel?

  /// 支付流水号（第三方支付平台返回的 trade_no）
  payTradeNo String?

  /// 支付完成时间
  paidAt DateTime?

  /// 订单关闭时间（超时/取消/退款）
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items OrderItem[]

  @@index([enterpriseId, createdAt(sort: Desc)])
  @@map("orders")
}

/// 订单明细：每一项对应一个数字员工的订阅
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  employeeId String
  employee   DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// 快照字段：下单时的员工名称（防止后续改名影响订单显示）
  employeeName String

  /// 快照字段：下单时的单价（元/年）
  unitPrice Decimal @db.Decimal(12, 2)

  /// 订阅周期（月），默认 12 个月
  periodMonths Int @default(12)

  /// 历史快照，恒为 1。收敛 EmployeeInstance 后「一企业一员工只雇佣一次」，
  /// 数量概念不再存在；此列保留是为了不改写已成交订单的记录形状。
  quantity Int @default(1)

  /// 快照字段：该订阅赠送的算力额度（元）
  includedComputeCNY Decimal @default(0) @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

/// 购物车：企业选择待订阅的员工
model CartItem {
  id String @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  employeeId String
  employee   DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// 订阅周期（月），默认 12 个月
  periodMonths Int @default(12)

  /// 加车人（User.id）
  addedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 同一企业对同一员工只能加一次车。收敛后「一企业一员工一雇佣关系」，
  /// 重复加车直接 409，没有「累加数量」这回事。
  @@unique([enterpriseId, employeeId])
  @@index([enterpriseId])
  @@map("cart_items")
}

/// 支付回调通知：记录第三方支付平台的异步通知原始数据
model PaymentNotify {
  id String @id @default(cuid())

  /// 支付渠道
  channel PayChannel

  /// 商户订单号（我方 Order.orderNo 或 RechargeOrder.orderNo）
  outTradeNo String

  /// 支付平台流水号（支付宝 trade_no / 微信 transaction_id）
  tradeNo String

  /// 回调原始报文（JSON 字符串，用于审计和补单）
  rawBody String @db.Text

  /// 签名是否验证通过
  verified Boolean

  /// 是否已处理（防止重复消费）
  processed Boolean @default(false)

  createdAt DateTime @default(now())

  /// 同一支付流水号只记录一次（幂等性保证）
  @@unique([channel, tradeNo])
  @@index([outTradeNo])
  @@map("payment_notifies")
}

/// 充值订单：企业算力充值的订单记录
model RechargeOrder {
  id String @id @default(cuid())

  /// 订单号（业务唯一标识，用于对外展示和支付回调匹配，格式：RCH + yyyyMMddHHmmss + 6位随机数）
  orderNo String @unique

  accountId String
  account   ComputeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// 充值金额（元）
  amount Decimal @db.Decimal(12, 2)

  status RechargeOrderStatus @default(PENDING)

  /// 支付渠道
  payChannel PayChannel?

  /// 支付流水号（第三方支付平台返回的 trade_no）
  payTradeNo String?

  /// 支付完成时间
  paidAt DateTime?

  /// 订单关闭时间（超时/取消）
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, createdAt(sort: Desc)])
  @@map("recharge_orders")
}

// ============================================================================
// Announcement (公告系统)
// ============================================================================

/// 公告：平台运营发布的全局公告
model Announcement {
  id      String           @id @default(cuid())
  title   String
  content String           @db.Text
  type    AnnouncementType @default(INFO)

  /// 优先级，数字越大越靠前
  priority Int @default(0)

  /// 生效时间（为空表示立即生效）
  startTime DateTime?

  /// 过期时间（为空表示永久有效）
  endTime DateTime?

  /// 是否已发布
  published Boolean @default(false)

  /// 创建者
  createdById String
  createdBy   User   @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, startTime, endTime])
  @@index([priority])
  @@map("announcements")
}

enum AnnouncementType {
  INFO // 信息
  WARNING // 警告
  ERROR // 错误
  SUCCESS // 成功
}
