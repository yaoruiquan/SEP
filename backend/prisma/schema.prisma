// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// User System (用户体系)
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // Hashed
  avatar    String?
  /// 全局角色。企业内身份不看这里，看 EnterpriseMember.role。
  /// ADMIN 表示平台运营人员（可访问 (platform) 分组）。
  role      UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions             ConversationSession[]
  contributedCapabilities Capability[]  @relation("CapabilityContributor")
  /// 企业成员身份。MVP 阶段每个用户恰好一条记录（不做多企业切换），
  /// 但用关联表保留结构能力，将来放开多企业无需数据迁移。
  memberships          EnterpriseMember[]
  approvedRequests     AccessRequest[] @relation("AccessRequestReviewer")
  devices              Device[]
  createdKnowledgeBases KnowledgeBase[] @relation("KnowledgeBaseCreator")
  uploadedDocuments    Document[]      @relation("DocumentUploader")

  @@map("users")
}

enum UserRole {
  USER         // B/C端用户
  CONTRIBUTOR  // 能力贡献者
  ADMIN        // 平台运营方
}

// ============================================================================
// Enterprise Organization (企业组织) —— P0 企业组织基座
// ============================================================================

/// 企业是数据与权限的隔离边界。所有业务数据的归属最终收敛到这里。
model Enterprise {
  id          String   @id @default(cuid())
  name        String
  /// 企业简介、行业等基础资料，MVP 阶段保持简单
  description String?  @db.Text
  logo        String?
  /// 运营端元数据：冻结状态、冻结原因等
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  departments    Department[]
  members        EnterpriseMember[]
  subscriptions  Subscription[]
  computeAccount ComputeAccount?
  instances      EmployeeInstance[]
  accessRequests AccessRequest[]
  knowledgeBases KnowledgeBase[]

  @@map("enterprises")
}

/// 部门。树形结构，parentId 自引用。
model Department {
  id           String   @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  name         String
  /// 父部门。为空表示顶级部门。
  parentId     String?
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Department[] @relation("DepartmentTree")

  sortOrder    Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  members   EnterpriseMember[]
  instances EmployeeInstance[]
  grants    EmployeeGrant[]
  knowledgeGrants KnowledgeGrant[]

  @@index([enterpriseId])
  @@index([parentId])
  @@map("departments")
}

/// 企业成员：User × Enterprise 的关联，承载企业内角色与所属部门。
///
/// 为什么用关联表而不是把 enterpriseId + role 塞进 User：
/// MVP 不做多企业切换（每人恰好一条记录），但一旦将来需要
/// "一个人属于多家企业"，塞进 User 就要做数据迁移 + 全量权限改写。
/// 关联表的成本近零，却保留了结构能力。
model EnterpriseMember {
  id           String   @id @default(cuid())

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  /// 企业内角色，与 User.role（全局角色）是两套体系
  role         EnterpriseRole @default(MEMBER)

  /// 所属部门。为空表示未分配部门（如企业创建者）。
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// 岗位名称，自由文本
  position     String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  grants           EmployeeGrant[]
  requestedAccess  AccessRequest[] @relation("AccessRequestRequester")

  @@unique([userId, enterpriseId])
  @@index([enterpriseId])
  @@index([departmentId])
  @@map("enterprise_members")
}

enum EnterpriseRole {
  ENTERPRISE_ADMIN  // 企业管理员：可订阅（花钱）、管组织、审批
  DEPT_MANAGER      // 部门负责人：管本部门成员与实例、审批本部门申请
  MEMBER            // 普通成员：仅使用被授权的员工，越权需申请
}

// ============================================================================
// Digital Employee (碳基员工)
// ============================================================================

model DigitalEmployee {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  industry    String   // 行业（电商/金融/医疗等）
  position    String   // 岗位（运营/客服/数据分析等）
  avatar      String?

  // Agent Configuration
  systemPrompt String  @db.Text  // Agent 人设
  modelId      String  @default("gpt-4o")
  maxSteps     Int     @default(10)

  // Status
  status      EmployeeStatus @default(DRAFT)

  /// 版本号（决策 14：提示式升级需要它）。
  /// 实例订阅时锁定版本，模板发新版后不自动跟进，仅提示企业主动升级。
  version     String  @default("1.0.0")

  // Pricing (暂时简化，不做复杂计费)
  price       Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?

  // Relations
  bindings      EmployeeCapabilityBinding[]
  subscriptions Subscription[]
  sessions      ConversationSession[]
  instances     EmployeeInstance[]
  packages      EmployeePackage[]

  @@map("digital_employees")
}

enum EmployeeStatus {
  DRAFT      // 草稿
  PENDING    // 待审核
  APPROVED   // 已审核通过（已上架）
  REJECTED   // 已拒绝
  ARCHIVED   // 已下架
}

// ============================================================================
// Employee Instance (企业员工实例) —— P1 模板与实例分离
// ============================================================================

/// 企业订阅某个员工后产生的企业专属实例。
///
/// 与 DigitalEmployee（市场侧模板）的区别：模板是"市场上卖的东西"，
/// 实例是"某家企业拿到的东西"，拥有企业内名称、部门、配置与状态。
///
/// ⚠️ 不能用 @@unique([enterpriseId, templateId]) —— 同一企业允许订阅
/// 同一模板的多个实例（如不同部门各一份）。
model EmployeeInstance {
  id           String   @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  /// 来源模板
  templateId   String
  template     DigitalEmployee @relation(fields: [templateId], references: [id], onDelete: Restrict)

  /// 订阅时锁定的模板版本。
  /// 必须存版本而非只存 templateId —— 否则无法实现「提示式升级」
  /// （模板发新版不自动跟进，仅提示企业主动确认）。
  templateVersion String

  /// 企业内自定义名称，如「视频工程师」
  name         String
  /// 归属部门。为空表示企业级共享实例。
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  status       InstanceStatus @default(PENDING_ACTIVATION)

  /// 企业侧配置：启用的知识库、模型路由、初始化资料等。
  /// 结构由模板的配置模式定义（员工包清单），故用 Json 承载。
  config       Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  grants       EmployeeGrant[]
  accessRequests AccessRequest[]
  knowledgeGrants KnowledgeGrant[]

  @@index([enterpriseId])
  @@index([templateId])
  @@index([departmentId])
  @@map("employee_instances")
}

enum InstanceStatus {
  PENDING_ACTIVATION  // 已订阅未激活
  ACTIVE              // 正常可用
  SUSPENDED           // 企业主动停用
  REVOKED             // 已回收（订阅到期/退订）
}

/// 员工实例的授权：某实例授权给哪个部门或哪个成员。
///
/// 二者互斥：departmentId 与 memberId 恰有一个非空。
/// 授权给部门 = 该部门所有成员可用；授权给成员 = 仅该成员可用。
model EmployeeGrant {
  id           String   @id @default(cuid())

  instanceId   String
  instance     EmployeeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// 授权对象之一：部门
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// 授权对象之二：具体成员
  memberId     String?
  member       EnterpriseMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// 限时授权到期时间。为空表示长期有效。
  /// 跨部门调用申请通过后签发的授权通常带过期时间。
  expiresAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// ⚠️ 唯一约束不在这里 —— 授权对象二选一，三列必有一列为 NULL，
  /// 而 Postgres 视 NULL 互不相等，`@@unique([instanceId, departmentId, memberId])`
  /// 永不生效（实测重复开通返回 201 而非 409）。
  /// 真正的约束是两个**部分唯一索引**，见迁移
  /// `20260728093000_fix_grant_unique_null_semantics`：
  ///   UNIQUE (instanceId, departmentId) WHERE departmentId IS NOT NULL
  ///   UNIQUE (instanceId, memberId)     WHERE memberId     IS NOT NULL
  /// Prisma schema 无法表达 WHERE 子句，故不要在此处「补回」@@unique。
  @@index([instanceId])
  @@index([departmentId])
  @@index([memberId])
  @@map("employee_grants")
}

/// 跨部门/越权调用申请。非管理员想用未授权的员工时发起。
model AccessRequest {
  id           String   @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  /// 申请人（企业成员）
  requesterId  String
  requester    EnterpriseMember @relation("AccessRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  /// 申请使用的实例
  instanceId   String
  instance     EmployeeInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// 申请理由 / 任务说明
  reason       String?  @db.Text
  /// 期望使用期限（天），审批时据此签发限时授权
  requestedDays Int?

  status       RequestStatus @default(PENDING)

  /// 审批人（平台 User，因审批者可能是企业管理员）
  reviewerId   String?
  reviewer     User?    @relation("AccessRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote   String?  @db.Text
  reviewedAt   DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enterpriseId])
  @@index([requesterId])
  @@index([instanceId])
  @@map("access_requests")
}

enum RequestStatus {
  PENDING    // 待审批
  APPROVED   // 已批准
  REJECTED   // 已驳回
  CANCELED   // 申请人撤回
}

// ============================================================================
// Silicon Capability (硅基能力)
// ============================================================================

model Capability {
  id          String         @id @default(cuid())
  name        String
  description String         @db.Text
  type        CapabilityType

  // Classification
  industry    String[]       // 适用行业
  position    String[]       // 适用岗位

  // Schema (JSON Schema for input/output validation)
  inputSchema  Json
  outputSchema Json

  // Contributor
  contributorId String
  contributor   User   @relation("CapabilityContributor", fields: [contributorId], references: [id])

  // Status
  status      CapabilityStatus @default(PENDING)

  // Statistics
  usageCount  Int     @default(0)
  rating      Float?

  // Metadata (flexible extension)
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approvedAt  DateTime?

  // Type-specific configs (one-to-one relations)
  agentConfig AgentConfig?
  rpaConfig   RPAConfig?
  skillConfig SkillConfig?
  aiAppConfig AIAppConfig?

  // Relations
  bindings      EmployeeCapabilityBinding[]
  toolExecutions ToolExecution[]

  @@map("capabilities")
}

enum CapabilityType {
  AGENT   // 智能体（Coze/Dify/N8N/OpenCode）
  RPA     // RPA 工作流
  SKILL   // 提示词模板 + LLM
  AI_APP  // AI 应用（Web/API）
}

enum CapabilityStatus {
  PENDING   // 待审核
  APPROVED  // 已通过
  REJECTED  // 已拒绝
}

// ============================================================================
// Capability Type-Specific Configs (分表存储类型特定配置)
// ============================================================================

model AgentConfig {
  id           String @id @default(cuid())
  capabilityId String @unique
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  platform     AgentPlatform  // coze | dify | n8n | opencode

  // Platform-specific fields (nullable based on platform)
  botId        String?  // Coze Bot ID
  apiKey       String?  // Dify API Key (encrypted)
  workflowUrl  String?  // N8N Webhook URL
  skillName    String?  // OpenCode skill name

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("agent_configs")
}

enum AgentPlatform {
  COZE
  DIFY
  N8N
  OPENCODE
}

model RPAConfig {
  id           String @id @default(cuid())
  capabilityId String @unique
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  platform        RPAPlatform  // 实在 | 影刀
  executionMode   RPAExecutionMode

  // Package info
  packageUrl      String?  // OSS URL for RPA package
  packageSha256   String?  // Package integrity check
  configDoc       String?  @db.Text  // Configuration documentation

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("rpa_configs")
}

enum RPAPlatform {
  SHIZAI  // 实在智能
  YINGDAO // 影刀
}

enum RPAExecutionMode {
  DOWNLOAD  // 下载模式（用户手动导入）
  CLOUD     // 云端执行
  CLIENT    // 客户端执行
}

model SkillConfig {
  id           String @id @default(cuid())
  capabilityId String @unique
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  // Prompt template
  template     String @db.Text

  // Model configuration
  modelId      String @default("gpt-4o-mini")
  temperature  Float  @default(0.7)
  maxTokens    Int    @default(2000)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("skill_configs")
}

model AIAppConfig {
  id           String @id @default(cuid())
  capabilityId String @unique
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  integrationMode AIAppIntegrationMode

  apiUrl       String?  // API endpoint
  webUrl       String?  // Web URL (for iframe/redirect)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ai_app_configs")
}

enum AIAppIntegrationMode {
  API       // HTTP API 调用
  IFRAME    // iframe 嵌入
  REDIRECT  // 跳转
}

// ============================================================================
// Binding Relationship (绑定关系)
// ============================================================================

model EmployeeCapabilityBinding {
  id           String @id @default(cuid())

  employeeId   String
  employee     DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  // 绑定配置
  priority     Int     @default(0)      // 优先级（0-100）
  enabled      Boolean @default(true)   // 是否启用
  config       Json?                    // 能力配置（JSON）

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, capabilityId])
  @@index([employeeId])
  @@index([capabilityId])
  @@map("employee_capability_bindings")
}

// ============================================================================
// Subscription (订阅)
// ============================================================================

/// 订阅。主体是【企业】而非个人 —— 订阅要花企业的钱，
/// 只有企业管理员能发起（其他角色走 AccessRequest 申请）。
model Subscription {
  id           String   @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  employeeId   String
  employee     DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  status       SubscriptionStatus @default(ACTIVE)

  startDate    DateTime @default(now())
  endDate      DateTime?

  // 企业侧订阅配置
  config       Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// 注意：这里保留唯一约束是因为「同一企业对同一模板只订阅一次」，
  /// 而多实例是在 EmployeeInstance 层面展开（一次订阅可开多个实例）。
  @@unique([enterpriseId, employeeId])
  @@index([enterpriseId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE   // 激活
  PAUSED   // 暂停
  EXPIRED  // 过期
}

// ============================================================================
// Conversation (对话)
// ============================================================================

model ConversationSession {
  id         String   @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId String
  employee   DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title      String?  // 自动生成或用户修改
  status     SessionStatus @default(ACTIVE)

  // 会话级模型覆盖：null 时用 employee.modelId
  modelId    String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  messages   Message[]
  toolExecutions ToolExecution[]

  @@map("conversation_sessions")
}

enum SessionStatus {
  ACTIVE    // 活跃
  ARCHIVED  // 归档
}

model Message {
  id        String   @id @default(cuid())

  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role      MessageRole
  content   String   @db.Text

  // Tool calls (if role is assistant and made tool calls)
  toolCalls Json?

  // Token usage (for billing)
  inputTokens  Int?
  outputTokens Int?

  createdAt DateTime @default(now())

  @@map("messages")
  @@index([sessionId, createdAt])
}

enum MessageRole {
  USER      // 用户消息
  ASSISTANT // AI 助手消息
  TOOL      // Tool 执行结果
}

model ToolExecution {
  id           String   @id @default(cuid())

  sessionId    String
  session      ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id])

  input        Json
  output       Json?

  duration     Int?     // 执行耗时（ms）
  tokensUsed   Int?     // Token 消耗（如适用）

  status       ExecutionStatus @default(SUCCESS)
  errorMessage String?  @db.Text

  createdAt    DateTime @default(now())

  @@map("tool_executions")
  @@index([sessionId, createdAt])
}

enum ExecutionStatus {
  SUCCESS
  FAILED
}

// ============================================================================
// Compute Platform (算力平台)
// ============================================================================

/// 算力账户。主体是【企业】—— 套餐含算力额度，按企业结算。
///
/// ⚠️ 多租户隔离要点：ComputeTransaction 自身没有 enterpriseId，
/// 必须经 accountId → ComputeAccount.enterpriseId 校验归属，
/// 否则拿到别家的 accountId 就能查别家账单。
model ComputeAccount {
  id           String   @id @default(cuid())

  enterpriseId String   @unique
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  balance      Float    @default(0)  // 余额（人民币）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions ComputeTransaction[]

  @@map("compute_accounts")
}

model ComputeTransaction {
  id        String   @id @default(cuid())

  accountId String
  account   ComputeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type      TransactionType
  amount    Float    // 正数=充值，负数=消费

  // 关联信息
  sessionId String?  // 如果是对话消费，关联会话

  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@map("compute_transactions")
  @@index([accountId, createdAt])
}

enum TransactionType {
  RECHARGE  // 充值
  CONSUME   // 消费
  REFUND    // 退款
}

// ============================================================================
// System Settings (系统配置 - key/value)
// ----------------------------------------------------------------------------
// 存运行时可配的系统级设置，如 sub2api 上游 BASE_URL / API_KEY。
// 运行时优先读本表，缺失时回退 .env。敏感值（isSecret=true）加密存储，
// 接口永不回传明文。
// ============================================================================
model SystemSetting {
  id        String   @id @default(cuid())

  key       String   @unique  // 如 SUB2API_BASE_URL / SUB2API_API_KEY
  value     String   @db.Text // 明文或密文（isSecret 决定）
  isSecret  Boolean  @default(false)
  label     String?  // 界面显示名
  category  String   @default("general") // 分组，如 sub2api

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ============================================================================
// Platform Model (平台启用模型白名单)
// ----------------------------------------------------------------------------
// 上游 sub2api 有几十个模型，但并非都适合对用户开放（图像模型、preview 版本、
// 内部工具模型等）。本表是「平台对用户开放的模型集合」：
//   - 管理员点「同步上游」→ 上游模型入库（新的默认 enabled=false，需手动启用）
//   - 上游已下架的模型不物理删除，标记 isStale，保留历史引用可读
//   - enabled=false 即软禁用：用户端选不到，但历史会话仍能显示模型名
// ============================================================================
model PlatformModel {
  id         String   @id @default(cuid())

  modelId    String   @unique
  label      String
  enabled    Boolean  @default(false)
  sortOrder  Int      @default(0)

  lastSeenAt DateTime @default(now())
  isStale    Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("platform_models")
  @@index([enabled, sortOrder])
}

// ============================================================================
// Employee Package（员工包）
// ----------------------------------------------------------------------------
// 运营上传对应版本的 ZIP 包，企业成员下载后本地部署即可使用。
// version 与 DigitalEmployee.version 对应 —— 运营发版时同步更新两处：
//   1. 此处的 EmployeePackage 行（新上传的文件）
//   2. DigitalEmployee.version（触发已有实例的 upgradeAvailable 提示）
//
// 下载权限：调用方在本企业对该员工模板的**任意一个 ACTIVE 实例**有有效授权，
// 即可下载。授权的两条路径（直接/部门）都算，过期授权不算。
// 平台运营（UserRole.ADMIN）无需授权直接可下载（用于测试验包）。
// ============================================================================
model EmployeePackage {
  id            String          @id @default(cuid())

  employeeId    String
  employee      DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// 发布时对应的 DigitalEmployee.version，用于在下载 UI 上显示版本号
  version       String

  /// 原始文件名（ZIP 上传时携带）
  filename      String?

  /// 服务器存储路径（相对 PACKAGE_STORAGE_PATH）
  storagePath   String?

  /// SHA-256 十六进制
  sha256        String?

  fileSizeBytes Int?

  /// pi package 引用（决策 5：复用 pi 自己的 package 机制）。
  /// 与 ZIP 字段互斥也可并存：没有 npm 包时只填 ZIP；两者都有时客户端优先用这个。
  /// { type: "npm" | "git", spec: "@sep/employee-video@1.2.0" }
  packageRef    Json?

  /// 上传者（平台运营账号的 User.id）
  uploadedBy    String

  /// 可选的更新说明（一句话）
  changelog     String?

  createdAt     DateTime @default(now())

  @@map("employee_packages")
  @@index([employeeId, createdAt(sort: Desc)])
}

// ============================================================================
// Device (客户端设备)
// ============================================================================

model Device {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 客户端生成的设备指纹（如 OS + CPU + 主板序列号的哈希）
  fingerprint   String
  platform      String    // darwin / win32 / linux
  clientVersion String?
  lastSeenAt    DateTime  @default(now()) @updatedAt
  revokedAt     DateTime? // 运营吊销后设置
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("devices")
}

// ============================================================================
// Knowledge Base (企业知识库 - MVP 空壳实现)
// ============================================================================

model KnowledgeBase {
  id           String   @id @default(cuid())
  enterpriseId String
  name         String
  description  String?  @db.Text
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enterprise   Enterprise         @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  creator      User               @relation("KnowledgeBaseCreator", fields: [createdBy], references: [id])
  documents    Document[]
  grants       KnowledgeGrant[]

  @@index([enterpriseId])
  @@map("knowledge_bases")
}

model Document {
  id              String         @id @default(cuid())
  knowledgeBaseId String
  filename        String
  originalName    String
  fileSize        Int
  mimeType        String
  storagePath     String         // 本地文件路径
  status          DocumentStatus @default(PENDING)
  uploadedBy      String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  uploader      User          @relation("DocumentUploader", fields: [uploadedBy], references: [id])

  @@index([knowledgeBaseId])
  @@map("documents")
}

enum DocumentStatus {
  PENDING    // 上传中
  READY      // 可用（MVP 直接设为此状态，不做解析）
  FAILED     // 失败
}

model KnowledgeGrant {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  instanceId      String?
  departmentId    String?
  createdAt       DateTime @default(now())

  knowledgeBase KnowledgeBase     @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  instance      EmployeeInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([knowledgeBaseId, instanceId])
  @@unique([knowledgeBaseId, departmentId])
  @@index([knowledgeBaseId])
  @@map("knowledge_grants")
}
