# Database
DATABASE_URL="postgresql://sep_user:sep_pass@localhost:5432/sep_platform"

# JWT Secret (change in production!)
JWT_SECRET="your-secret-key-change-in-production"

# Server
PORT=3001
NODE_ENV=development

# sub2api Configuration (AI Model Gateway)
SUB2API_BASE_URL="https://longdaoai.cn/v1"
SUB2API_API_KEY="sk-your-api-key-here"
SUB2API_DEFAULT_MODEL="gpt-3.5-turbo"

# Currency Exchange Rate
USD_TO_CNY_RATE="7.2"

# Client Token TTL (minutes)
CLIENT_TOKEN_TTL_MINUTES="15"

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ===== Embedding（知识库向量化）=====
EMBEDDING_PROVIDER=tei            # tei | openai | wasm
EMBEDDING_BASE_URL=http://localhost:8080   # compose 内用 http://embedding:8080
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=1024
