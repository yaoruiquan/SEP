# Database
DATABASE_URL="postgresql://sep_user:sep_pass@localhost:5432/sep_platform"

# JWT Secret (change in production!)
JWT_SECRET="your-secret-key-change-in-production"

# Server
PORT=3001
NODE_ENV=development

# Public web/CDN origin serving /assets (not the API origin). Required in production.
ASSET_BASE_URL="http://localhost:3000"
DEFAULT_AVATAR_STYLE="silicon-3d"

# sub2api Configuration (AI Model Gateway)
SUB2API_BASE_URL="https://longdaoai.cn/v1"
SUB2API_API_KEY="sk-your-api-key-here"
SUB2API_DEFAULT_MODEL="gpt-3.5-turbo"

# Real images require a separately configured media connection, verified profile,
# and enterprise policy. Configure the connection through /admin/media/connection.
MEDIA_GATEWAY_REAL_ENABLED=false

# Independent video execution gate; never enables image execution or mock mode.
MEDIA_VIDEO_REAL_ENABLED=false
# Optional dedicated sub2api video connection. Set both or leave both absent
# to reuse the Web media connection. These are relay credentials, not A6 credentials.
# MEDIA_VIDEO_BASE_URL=https://your-sub2api.example/v1
# MEDIA_VIDEO_API_KEY=
# Private persistent output cache; no public static route may expose this path.
# MEDIA_VIDEO_CACHE_DIR=/app/uploads/media-video
# MEDIA_VIDEO_FFPROBE_PATH=ffprobe

# Per verified enterprise/member/subscription; shared across models and tasks.
GATEWAY_MODEL_RATE_LIMIT=60
GATEWAY_MODEL_RATE_WINDOW_MS=60000

# Streaming upstream timeouts (milliseconds): headers, idle gap, total duration.
GATEWAY_STREAM_HEADER_TIMEOUT_MS=120000
GATEWAY_STREAM_IDLE_TIMEOUT_MS=120000
GATEWAY_STREAM_TOTAL_TIMEOUT_MS=600000

# Model runtime policy writes remain disabled until all backend instances are upgraded.
MODEL_RUNTIME_POLICY_WRITE_ENABLED=false
# Agreed non-secret fingerprint from GET /settings/model-runtime-policy preflight.
MODEL_RUNTIME_POLICY_ENV_FINGERPRINT=
GATEWAY_NON_STREAM_TIMEOUT_MS=120000
SUB2API_STREAM_IDLE_TIMEOUT_MS=45000
WEB_MODEL_TOTAL_TIMEOUT_MS=600000
PLANNER_REQUEST_TIMEOUT_MS=120000
GATEWAY_MEMBER_RPM=120
GATEWAY_ENTERPRISE_RPM=600
GATEWAY_MEMBER_CONCURRENCY=4
GATEWAY_ENTERPRISE_CONCURRENCY=32
# 0 follows upstream without sending an output budget; positive integers opt into a budget.
GATEWAY_DEFAULT_MAX_TOKENS=0
WEB_DEFAULT_MAX_OUTPUT_TOKENS=0
PLANNER_MAX_OUTPUT_TOKENS=0
# 0 disables the SEP ceiling; supplier limits and known model capabilities still apply.
MODEL_MAX_OUTPUT_TOKENS=0
# Conservative request-byte + output reservation, not billed usage; 0 disables it.
GATEWAY_ENTERPRISE_TOKEN_BUDGET=0

# Currency Exchange Rate
USD_TO_CNY_RATE="7.2"

# Client Token TTL (minutes)
CLIENT_TOKEN_TTL_MINUTES="15"

# CORS (comma-separated origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ========================================
# Embedding 服务配置（知识库向量化）
# ========================================
# Embedding uses private Ollama, independently of chat/sub2api credentials.
# Explicit EMBEDDING_PROVIDER=sub2api retains the relay embedding path if needed.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
# Create this local alias after verifying the manifest; see docs/deployment/embedding-service.md.
EMBEDDING_MODEL=bge-m3:sep-790764642607
EMBEDDING_MODEL_DIGEST=sha256:7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
EMBEDDING_TOKENIZER=BAAI/bge-m3@5617a9f61b028005a4858fdac845db406aefb181
# Provision tokenizer.json + tokenizer_config.json locally; never download weights at runtime.
EMBEDDING_TOKENIZER_PATH=
EMBEDDING_DISTANCE=cosine
# Mount a durable private volume, outside the public uploads directory.
KNOWLEDGE_PRIVATE_PATH=

# 向量维度（bge-m3=1024）
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_MS=120000

# Knowledge requests: atomic enterprise + member quotas; Redis outages return 503.
KNOWLEDGE_RATE_LIMIT_WINDOW_MS=60000
KNOWLEDGE_RATE_LIMIT_TIMEOUT_MS=1000
KNOWLEDGE_SEARCH_MEMBER_RATE_LIMIT=60
KNOWLEDGE_SEARCH_ENTERPRISE_RATE_LIMIT=600
KNOWLEDGE_SOURCE_MEMBER_RATE_LIMIT=120
KNOWLEDGE_SOURCE_ENTERPRISE_RATE_LIMIT=1200
# Applies when retiring a version; existing expiry timestamps are preserved.
KNOWLEDGE_HISTORY_RETENTION_DAYS=30
KNOWLEDGE_RETENTION_BATCH_SIZE=25
# GET /admin/knowledge/metrics evaluates response-only alerts (no external delivery).
KNOWLEDGE_METRICS_SEARCH_P95_MS=3000
KNOWLEDGE_METRICS_FAILURE_RATE=0.05
KNOWLEDGE_METRICS_DEGRADATION_RATE=0.2
KNOWLEDGE_METRICS_NO_MATCH_RATE=0.5
KNOWLEDGE_METRICS_JOB_BACKLOG=100
KNOWLEDGE_METRICS_JOB_WAIT_MS=300000
KNOWLEDGE_METRICS_FAILED_JOBS=0
KNOWLEDGE_METRICS_CLEANUP_DELAY_MS=3600000
KNOWLEDGE_METRICS_STORAGE_BYTES=10737418240
KNOWLEDGE_METRICS_INDEX_CHUNKS=1000000
