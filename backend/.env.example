# Database
DATABASE_URL="postgresql://sep_user:sep_pass@localhost:5432/sep_platform"

# JWT Secret (change in production!)
JWT_SECRET="your-secret-key-change-in-production"

# Server
PORT=3001
NODE_ENV=development

# Public web/CDN origin serving /assets (not the API origin). Required in production.
ASSET_BASE_URL="http://localhost:3000"
DEFAULT_AVATAR_STYLE="silicon-3d"

# sub2api Configuration (AI Model Gateway)
SUB2API_BASE_URL="https://longdaoai.cn/v1"
SUB2API_API_KEY="sk-your-api-key-here"
SUB2API_DEFAULT_MODEL="gpt-3.5-turbo"

# Per verified enterprise/member/subscription; shared across models and tasks.
GATEWAY_MODEL_RATE_LIMIT=60
GATEWAY_MODEL_RATE_WINDOW_MS=60000

# Streaming upstream timeouts (milliseconds): headers, idle gap, total duration.
GATEWAY_STREAM_HEADER_TIMEOUT_MS=120000
GATEWAY_STREAM_IDLE_TIMEOUT_MS=120000
GATEWAY_STREAM_TOTAL_TIMEOUT_MS=600000

# Model runtime policy writes remain disabled until all backend instances are upgraded.
MODEL_RUNTIME_POLICY_WRITE_ENABLED=false
# Agreed non-secret fingerprint from GET /settings/model-runtime-policy preflight.
MODEL_RUNTIME_POLICY_ENV_FINGERPRINT=
GATEWAY_NON_STREAM_TIMEOUT_MS=120000
SUB2API_STREAM_IDLE_TIMEOUT_MS=45000
WEB_MODEL_TOTAL_TIMEOUT_MS=600000
PLANNER_REQUEST_TIMEOUT_MS=120000
GATEWAY_MEMBER_RPM=120
GATEWAY_ENTERPRISE_RPM=600
GATEWAY_MEMBER_CONCURRENCY=4
GATEWAY_ENTERPRISE_CONCURRENCY=32
GATEWAY_DEFAULT_MAX_TOKENS=4096
WEB_DEFAULT_MAX_OUTPUT_TOKENS=4096
PLANNER_MAX_OUTPUT_TOKENS=4000
# Evaluate this new ceiling against existing model capabilities and workloads.
MODEL_MAX_OUTPUT_TOKENS=32768
# Conservative request-byte + output reservation, not billed usage; 0 disables it.
GATEWAY_ENTERPRISE_TOKEN_BUDGET=0

# Currency Exchange Rate
USD_TO_CNY_RATE="7.2"

# Client Token TTL (minutes)
CLIENT_TOKEN_TTL_MINUTES="15"

# CORS (comma-separated origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ========================================
# Embedding 服务配置（知识库向量化）
# ========================================
# 当前正式部署：Ollama 提供 OpenAI-compatible API。
# provider 保持 openai，模型和维度必须与 Ollama 实际返回一致。
EMBEDDING_PROVIDER=openai

# 开发环境：本地 Ollama OpenAI 兼容接口
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_KEY=ollama-local

# 向量维度（bge-m3=1024）
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=120000
