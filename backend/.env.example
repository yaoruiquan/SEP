# Database
DATABASE_URL="postgresql://sep_user:sep_pass@localhost:5432/sep_platform"

# JWT Secret (change in production!)
JWT_SECRET="your-secret-key-change-in-production"

# Server
PORT=3001
NODE_ENV=development

# sub2api Configuration (AI Model Gateway)
SUB2API_BASE_URL="https://longdaoai.cn/v1"
SUB2API_API_KEY="sk-your-api-key-here"
SUB2API_DEFAULT_MODEL="gpt-3.5-turbo"

# Currency Exchange Rate
USD_TO_CNY_RATE="7.2"

# Client Token TTL (minutes)
CLIENT_TOKEN_TTL_MINUTES="15"

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# ========================================
# Embedding 服务配置（知识库向量化）
# ========================================
# Provider 选择：
# - openai: OpenAI-compatible API (sub2api / 真实 OpenAI / 本地 Infinity)
# - tei: HuggingFace TEI (仅 x86_64，ARM64 不支持)
# - wasm: 浏览器端 Transformers.js (实验性)
EMBEDDING_PROVIDER=openai

# 开发环境：本地 Ollama OpenAI 兼容接口
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_KEY=ollama-local

# 🚀 生产环境（x86_64 Linux 服务器）配置：
# - docker-compose.yml 取消注释 embedding 服务
# - 使用本地 Infinity 推理（免费，无外部依赖）
# EMBEDDING_BASE_URL=http://embedding:8080  # compose 服务名，禁止使用 localhost
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 向量维度 (bge-m3=1024)
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=30000
